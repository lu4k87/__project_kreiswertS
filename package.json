{
  "name": "kreiswerts",
  "version": "0.1.0",
  "private": true,
  "description": "KreiswertS – platform prototype for circular plastic material exchange in Kamp-Lintfort",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev -H 127.0.0.1",
    "build": "next build",
    "start": "next start -H 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test",
    "db:push": "drizzle-kit push",
    "db:seed": "node scripts/seed.mjs",
    "data:export": "node scripts/data-csv.mjs export",
    "data:import": "node scripts/data-csv.mjs import",
    "db:pull": "drizzle-kit pull",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "auth:schema": "npx @better-auth/cli@1.4.21 generate --config src/server/auth.ts --output src/server/db/auth-schema.ts -y",
    "demo:db": "node demo/make-db.mjs",
    "demo:build": "node demo/build.mjs",
    "demo:serve": "node demo/serve.mjs",
    "demo:test": "node demo/test.mjs"
  },
  "dependencies": {
    "better-auth": "^1.7.26",
    "drizzle-orm": "^0.45.4",
    "maplibre-gl": "^5.24.1",
    "next": "^16.4.6",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.6.1",
    "@electric-sql/pglite-socket": "^0.3.1",
    "@noble/hashes": "^2.4.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^20.19.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitejs/plugin-rsc": "^0.5.39",
    "buffer": "^6.0.3",
    "dotenv": "^18.0.10",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "pathe": "^2.0.3",
    "playwright-core": "^1.65.1",
    "postcss": "^8.5.33",
    "react-server-dom-webpack": "^19.3.1",
    "tailwindcss": "^4.3.5",
    "typescript": "~5.9.3",
    "vinext": "1.4.7",
    "vite": "^8.4.0",
    "vitest": "^4.1.12"
  }
}
