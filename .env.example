# Kopie als .env anlegen (cp .env.example .env) – .env wird nie eingecheckt.
# Linux/macOS danach: chmod 600 .env (nur der eigene Nutzer darf die Datei lesen).
# Lokale PostgreSQL-Datenbank: scripts/setup-postgres.sh (Windows: .ps1) legt Nutzer + Datenbank an und gibt am Ende
# die fertige Zeile mit Zufallspasswort aus → die folgende Zeile damit ersetzen.
DATABASE_URL=postgres://kreiswerts:PASSWORT@localhost:5432/kreiswerts

# Better Auth: geheimer Schlüssel (mind. 32 Zeichen, sonst startet der Server nicht) → erzeugen mit: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Adresse, unter der die App läuft
BETTER_AUTH_URL=http://localhost:3000
