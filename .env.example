# Copy to .env (cp .env.example .env) – .env is never committed.
# Linux/macOS afterwards: chmod 600 .env (only your own user may read the file).
# Local PostgreSQL database: scripts/setup-postgres.sh (Windows: .ps1) creates user + database and prints
# the finished line with a random password at the end → replace the following line with it.
DATABASE_URL=postgres://kreiswerts:PASSWORD@localhost:5432/kreiswerts

# Better Auth: secret key (at least 32 characters, otherwise the server answers every request with HTTP 500) → generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Address the app runs at
BETTER_AUTH_URL=http://localhost:3000
