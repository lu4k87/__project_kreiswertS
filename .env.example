# Kopie als .env anlegen (cp .env.example .env) – .env wird nie eingecheckt.
# Lokale PostgreSQL-Datenbank (scripts/setup-postgres.sh bzw. .ps1 unter Windows legt Nutzer + Datenbank an)
DATABASE_URL=postgres://kreiswerts:kreiswerts@localhost:5432/kreiswerts

# Better Auth: geheimer Schlüssel (mind. 32 Zeichen) → erzeugen mit: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Adresse, unter der die App läuft
BETTER_AUTH_URL=http://localhost:3000
